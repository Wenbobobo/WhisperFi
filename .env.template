# WhisperFi Environment Configuration Template
# ============================================================================
# SECURITY WARNING: Never commit .env file with real values to git!
# Copy this template to .env and fill in your actual values
# ============================================================================

# ============================================================================
# Sepolia Testnet Configuration
# ============================================================================

# Sepolia RPC URL (get free endpoint from Alchemy or Infura)
# Alchemy: https://www.alchemy.com/ (recommended)
# Infura: https://infura.io/
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Deployer wallet private key (must have Sepolia ETH)
# Get test ETH from: https://sepoliafaucet.com/
PRIVATE_KEY=your_private_key_without_0x_prefix

# Optional: Etherscan API key for contract verification
# Get from: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# ============================================================================
# Frontend Configuration (for Sepolia)
# ============================================================================

# Public RPC endpoint (safe to expose in frontend)
NEXT_PUBLIC_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Chain ID (11155111 = Sepolia)
NEXT_PUBLIC_CHAIN_ID=11155111

# ============================================================================
# Local Development (Hardhat)
# ============================================================================

# Hardhat local RPC
# NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
# NEXT_PUBLIC_CHAIN_ID=31337

# ============================================================================
# Optional: Gas Reporting
# ============================================================================

REPORT_GAS=false
# COINMARKETCAP_API_KEY=

# ============================================================================
# IMPORTANT SECURITY NOTES
# ============================================================================
#
# 1. NEVER commit .env file with real private keys to git
# 2. Use different wallets for testnet and mainnet
# 3. For production, use hardware wallet or key management service
# 4. Rotate keys regularly and keep backups secure
# 5. The .env file is in .gitignore - keep it that way!
#
# For wallet configuration, you can also use config/wallet.env
# See docs/SEPOLIA_DEPLOYMENT.md for detailed setup instructions
#
